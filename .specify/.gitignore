# Machine-local Spec Kit state — not meant to be shared.
# Managed by the Specify CLI; safe to edit (your changes are preserved on refresh).

# Local pointer to the current feature directory. Rewritten every time you
# switch features, so it is per-checkout state rather than something to share.
feature.json

# Per-machine extension config overrides.
extensions/*/local-config.yml

# Executable adapter packages and their per-checkout provenance registry.
# Execution consent is stored separately in the user's local trust registry.
integrations/packages/
integrations/packages.json

# ==============================================================================
# 1. SEKRETY, ŚRODOWISKO I AI (GitHub Copilot / Spec-Driven Development)
# ==============================================================================
# Lokalne pliki środowiskowe i klucze API (np. do modeli AI)
.env
.env.local
.env.*
!.env.example

# Narzędzia i agenci GitHub Copilot / GitHub Spec Kit
.github/copilot-instructions.md.bak  # Kopie zapasowe instrukcji (jeśli tworzone ręcznie)
.copilot-state/                     # Logi sesji i stany agenta tymczasowego
.github/.copilot/                   # Lokalne pliki podręczne Copilota

# Foldery konfiguracyjne IDE (VS Code / PyCharm)
.vscode/settings.json               # Można usunąć z ignore, jeśli zespół współdzieli ustawienia
.vscode/tasks.json
.vscode/launch.json
.idea/                               # Jeśli używasz PyCharm

# ==============================================================================
# 2. PYTHON (Środowiska, Cache i Budowanie)
# ==============================================================================
# Środowiska wirtualne
venv/
.venv/
env/
.env/
ENV/
pyenv/

# Pamięć podręczna bajtkodu (Byte-compiled / optimized / DLL files)
__pycache__/
*.py[cod]
*$py.class

# Dystrybucja i budowanie paczek
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Narzędzia QA (Pytest, Mypy, Ruff, Coverage)
.target/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
htmlcov/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# 3. PLIKI SYSTEMOWE I TYMCZASOWE
# ==============================================================================
.DS_Store
Thumbs.db
*.log
tmp/
.temp/
